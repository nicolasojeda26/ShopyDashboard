# Shopify App Credentials
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
SHOPIFY_SHOP_DOMAIN=da6gne-6x.myshopify.com
SHOPIFY_API_VERSION=2024-10

# Shopify Scopes required for dropshipping lifecycle
SHOPIFY_SCOPES=read_products,write_products,read_themes,write_themes,read_files,write_files,read_inventory,write_inventory

# Access token obtained via OAuth 2.0 or Custom App install
SHOPIFY_ACCESS_TOKEN=

# Required to access the private dashboard and any administrative API route
DASHBOARD_API_TOKEN=generate_a_long_random_value

# Optional: Redirect URI for OAuth 2.0 Web Flow
SHOPIFY_REDIRECT_URI=https://localhost:8000/auth/callback

# Mock / Dry Run Mode
DRY_RUN=false

# CJ Dropshipping API v2 (CJ -> Apps -> API -> Add API)
SUPPLIER_API_KEY=your_cj_api_key_here
SUPPLIER_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
SUPPLIER_NAME=CJ_DROPSHIPPING
# Leave false if the store is connected through CJ's Shopify app (CJ already imports orders)
SUPPLIER_AUTO_ORDER=false
SUPPLIER_LOGISTIC_NAME=CJPacket Ordinary
SUPPLIER_FROM_COUNTRY=CN
# 2 = pay from CJ wallet balance, 3 = create order only and pay it in CJ
SUPPLIER_PAY_TYPE=3
# Let the inventory sync change Shopify prices (cost x 2.5, shipping not included)
SYNC_AUTO_REPRICE=false

# LLM AI Copywriting (Gemini / OpenAI)
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini

# Image Generation AI (DALL-E 3, Pollinations, Stability)
IMAGE_GEN_API_KEY=your_openai_or_stability_key_here
IMAGE_GEN_PROVIDER=pollinations
IMAGE_GEN_MODEL=dall-e-3
